# WISES Robot Environment Configuration
# Copy this file to .env and adjust paths as needed

source /opt/ros/jazzy/setup.bash

# Repository root directory (absolute path)
REPO_ROOT=/home/pawan/WISES_Robot

# ROS workspaces (relative to REPO_ROOT by default, or absolute paths)
YAHBOOMCAR_WS=${REPO_ROOT}/realworld_ws/yahboomcar_ws
M3PRO_WS=${REPO_ROOT}/realworld_ws/M3Pro_ws
SLAM_WS=${REPO_ROOT}/realworld_ws/slam_comparison_ws
SENSORS_WS=${REPO_ROOT}/realworld_ws/custom_Sensors_ws
DIGITALTWIN_WS=${REPO_ROOT}/digitaltwin_ws

# micro-ROS agent (absolute path - typically outside repo)
MICROROS_WS=/home/jetson/microROS_agent

MAP_VAULT_DIR=~/maps

MAP_NAV_DIR=${REPO_ROOT}/realworld_ws/M3Pro_ws/install/M3Pro_navigation/share/M3Pro_navigation/map
MAP_NAV_DIR_SRC=${REPO_ROOT}/realworld_ws/M3Pro_ws/src/yahboom_mapping/maps
RTABMAP_DB_DIR=~/.ros/