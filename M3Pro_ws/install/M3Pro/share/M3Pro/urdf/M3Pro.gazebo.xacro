<?xml version="1.0"?>
<robot name="M3Pro" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- Pulls in the robot description. M3Pro.urdf (the raw SolidWorks export) is
       left completely untouched. instead we include an auto-generated copy,
       M3Pro.collision_fix.urdf, which is identical except that base_link and
       the 4 wheels use simple box/cylinder collision shapes instead of the
       full detailed mesh. Gazebo's ODE physics engine can't reliably resolve
       collisions against complex concave meshes (it was slowly sinking the
       robot through the floor at a constant rate); simple primitives fix that.
       Visual appearance is unaffected. only the invisible collision shape
       changed. -->
  <xacro:include filename="$(find M3Pro)/urdf/M3Pro.urdf" />

  <!-- ===================== Gazebo materials (cosmetic only) ===================== -->
  <gazebo reference="base_link">
    <material>Gazebo/Grey</material>
  </gazebo>

  <!-- ===================== Holonomic (mecanum) drive plugin ===================== -->
  <!-- Same idea as fake_odom_driver.py: it listens on /cmd_vel and integrates
       (vx, vy, wz) into a pose. The difference is this now runs INSIDE Gazebo's
       physics engine, moving the actual simulated robot body in the 3D world,
       and publishing /odom + the odom->base_footprint TF for real. -->
  <gazebo>
    <plugin name="mecanum_drive_controller" filename="libgazebo_ros_planar_move.so">
      <commandTopic>cmd_vel</commandTopic>
      <odometryTopic>odom</odometryTopic>
      <odometryFrame>odom</odometryFrame>
      <odometryRate>30.0</odometryRate>
      <robotBaseFrame>base_footprint</robotBaseFrame>
      <broadcastTF>true</broadcastTF>
    </plugin>
  </gazebo>

</robot>
