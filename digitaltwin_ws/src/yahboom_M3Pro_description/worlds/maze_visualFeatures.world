        <!--
            BORDER: each wall a distinct vivid hue so the camera always has
            a saturated colour transition at the arena boundary.
        -->
        <model name="border">
            <pose>0 0 1 0 0 0</pose>
            <static>true</static>
            <link name="wall1">
                <pose>-10.005 0 0 0 0 0</pose>
                <collision name="wall1_collision">
                    <geometry><box><size>0.01 20 2</size></box></geometry>
                </collision>
                <visual name="wall1_visual">
                    <geometry><box><size>0.01 20 2</size></box></geometry>
                    <material><ambient>0.85 0.10 0.10 1</ambient><diffuse>0.85 0.10 0.10 1</diffuse><specular>0.34 0.04 0.04 1</specular></material>
                </visual>
            </link>
            <link name="wall2">
