<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
    <xacro:macro name="M3Pro_lidar_links" params="">

  <!-- ===== Links & Joints ===== -->

    <link name="laser0_frame">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.0973137194820634"/>
      <inertia ixx="4.4524583220077E-05" ixy="-1.31175451437957E-10" ixz="2.4691417638339E-09"
               iyy="4.45241370387487E-05" iyz="-4.9776391261432E-10" izz="7.45963443980609E-05"/>
    </inertial>
  </link>
  <joint name="laser0_frame_Joint" type="fixed">
    <origin xyz="-0.11617 0.09156 0.1253" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child link="laser0_frame"/>
  </joint>

  <link name="laser1_frame">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.0973137194820634"/>
      <inertia ixx="4.4524583220077E-05" ixy="-1.31175451437957E-10" ixz="2.4691417638339E-09"
               iyy="4.45241370387487E-05" iyz="-4.9776391261432E-10" izz="7.45963443980609E-05"/>
    </inertial>
  </link>
  <joint name="laser1_frame_Joint" type="fixed">
    <origin xyz="0.10766 -0.09078 0.1253" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child link="laser1_frame"/>
  </joint>

  <!-- ===== Gazebo Harmonic LiDAR Sensors ===== -->
  <!-- Sensor data is bridged to ROS via ros_gz_bridge in gazebo_display.launch.py -->

  <gazebo reference="laser0_frame">
    <sensor name="laser0" type="gpu_lidar">
      <topic>scan0</topic>
      <pose>0 0 0 0 0 0</pose>
      <visualize>true</visualize>
      <update_rate>10</update_rate>
      <ray>
        <scan>
          <horizontal>
            <samples>360</samples>
            <resolution>1</resolution>
            <min_angle>-3.14159</min_angle>
            <max_angle>3.14159</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>0.05</min>
          <max>12.0</max>
          <resolution>0.54</resolution>
        </range>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.01</stddev>
        </noise>
      </ray>
    </sensor>
  </gazebo>

  <gazebo reference="laser1_frame">
    <sensor name="laser1" type="gpu_lidar">
      <topic>scan1</topic>
      <pose>0 0 0 0 0 0</pose>
      <visualize>true</visualize>
      <update_rate>10</update_rate>
      <ray>
        <scan>
          <horizontal>
            <samples>360</samples>
            <resolution>1</resolution>
            <min_angle>-3.14159</min_angle>
            <max_angle>3.14159</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>0.05</min>
          <max>12.0</max>
          <resolution>0.54</resolution>
        </range>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.01</stddev>
        </noise>
      </ray>
    </sensor>
  </gazebo>
 </xacro:macro>

</robot>
